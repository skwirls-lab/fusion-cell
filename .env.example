# Copy to .env.local. Never commit .env.local.

# --- AI (OpenRouter, OpenAI-compatible) ---
OPENROUTER_API_KEY=sk-or-v1-...
# The vendor prefix (deepseek/) is required by OpenRouter.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Optional. Model thinking: off (the default; measured 25-150 s per question), low | medium | high,
# or default (the model decides; measured 3-13 MINUTES per question, which no serverless limit survives).
# OPENROUTER_REASONING=off

# --- Database ---
# Production: Supabase Postgres via the SESSION POOLER string (port 5432, not the
# direct host). URL-encode special characters in the password (@ -> %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local/dev/tests: leave DATABASE_URL unset or set DB_DRIVER=pglite to use in-process
# Postgres (PGlite). PGLITE_DIR is a folder (persists) or "memory".
# DB_DRIVER=pglite
# PGLITE_DIR=.pglite/dev

# --- Supabase (not required by the app yet; kept for Realtime/Auth later) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
APP_PASSWORD=change-me
